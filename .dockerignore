# Never ship the persisted data, git history or CI config into the image.
data/
.git
.gitignore
.github
.env
.env.*
*.log

# Docs and editor/OS noise. NOTE: do not add a blanket `*.md` here — the agent
# skills under skills/<name>/SKILL.md must stay in the build context.
README.md
AGENTS.md
LICENSE
.vscode
.idea
.DS_Store

# The image needs only the entrypoint and the skills; compose files and the
# Dockerfile itself are not copied into it.
Dockerfile
docker-compose.yml
compose.ghcr.yaml
.dockerignore
