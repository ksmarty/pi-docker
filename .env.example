# Copy to .env and adjust. Used by docker-compose.yml / compose.ghcr.yaml.
#
# Base directory that holds the persisted data. The compose files mount
# ${USERDIR}/data/pi/data -> /data and ${USERDIR}/data/pi/workspace -> /workspace.
USERDIR=/home/youruser

# Public hostname and origin (used by both compose files when running behind
# Traefik or any reverse proxy). Keep them in step with the Traefik Host rule.
#
# COLLIE_PUBLIC_HOSTS is an allow-list: Collie refuses every Host it does not
# recognize, which is why `http://<server-ip>:8787` does not answer even though
# the app is running.
COLLIE_PUBLIC_HOSTS=pi.example.com

# Without an origin Collie's UI loads as an empty page behind a proxy. This is
# the most common way a working Collie looks broken.
COLLIE_ALLOWED_ORIGINS=https://pi.example.com

# Used for links Collie generates (notifications, push, pairing).
COLLIE_PUBLIC_URL=https://pi.example.com

# Writes are authorized by pairing a device once inside the container:
#   docker exec -it collie collie pair
# It prints an 8-character code, valid for 10 minutes, which you enter in the
# PWA under Settings -> System -> Paired devices.
#
# Optional: pin the versions baked into the image at build time. "latest" uses
# each vendor's installer, which verifies the release checksum.
# COLLIE_VERSION=v1.16.2
# HERDR_VERSION=0.9.3
