# Copy to .env and adjust. Used by docker-compose.yml / compose.ghcr.yaml.
#
# Base directory that holds the persisted data. The compose files mount
# ${USERDIR}/data/pi/data -> /data and ${USERDIR}/data/pi/workspace -> /workspace.
USERDIR=/home/youruser

# Public URL the PWA is served from. Keep it in step with the Traefik Host rule.
# Optional — the plugin builds the address from the request it receives — but set
# it explicitly if you terminate TLS anywhere else.
PI_PUBLIC_URL=https://pi.example.com

# Where the web UI listens *inside* the container. Only the reverse proxy needs
# to know it; change it and update the loadbalancer label in the compose file too.
HERDR_WEB_HOST=0.0.0.0
HERDR_WEB_PORT=7317

# Optional shared secret for the web UI.
#
#   unset  -> the plugin's own device pairing authorizes writes. Your reverse
#             proxy's login is the only gate until the first device pairs, and
#             the plugin prints exactly that warning on every start until then.
#   set    -> a secret is required in addition. This is the vendor's recommended
#             setup for any deployment behind a reverse proxy, and it is the right
#             answer if the app is reachable from anywhere other than a network
#             you control the edge of.
#
# Whatever you put here is written to the plugin's own env file
# (~/.config/herdr/plugins/config/devswha.herdr-web-ui/env inside the volume,
# chmod 600) and never printed to the log.
# HERDR_WEB_TOKEN=change-me

# Optional: pin the versions baked into the image at build time. "latest" resolves
# to the newest release and the build then asserts the version it landed on.
# HERDR_VERSION=0.9.3
# HERDR_WEB_UI_VERSION=v0.3.50
# PI_CODING_AGENT_VERSION=latest
# NODE_VERSION=26
