# Copy to .env and adjust. Used by docker-compose.yml / compose.ghcr.yaml.
#
# Base directory that holds the persisted data. The compose files mount
# ${USERDIR}/data/pi/data -> /data and ${USERDIR}/data/pi/workspace -> /workspace.
USERDIR=/home/youruser

# Public hostname / origin of the UI (used by compose.ghcr.yaml). Set these when
# running behind Traefik or any reverse proxy.
PI_WEB_ALLOW_HOSTS=pi.example.com
PI_WEB_ALLOW_ORIGINS=https://pi.example.com

# Optional shared-secret gate; leave empty to disable.
# PI_WEB_TOKEN=change-me
